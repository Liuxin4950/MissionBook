  "fixed_sql": [
    {
      "name": "missions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"missions\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NULL, \"why\" TEXT NULL, \"verification_policy\" TEXT NOT NULL DEFAULT 'SELF_REPORT', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"cancelled_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "mission_schedule_revisions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"mission_schedule_revisions\" (\"id\" TEXT NOT NULL, \"mission_id\" TEXT NOT NULL REFERENCES missions (id), \"revision_number\" INTEGER NOT NULL, \"scheduled_date\" TEXT NOT NULL, \"time_zone\" TEXT NOT NULL, \"time_policy\" TEXT NOT NULL DEFAULT 'FLEXIBLE', \"fixed_start_at\" INTEGER NULL, \"planned_duration_minutes\" INTEGER NOT NULL, \"evidence_deadline_at\" INTEGER NULL, \"change_reason\" TEXT NULL, \"changed_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"mission_id\", \"revision_number\"));"
        }
      ]
    },
    {
      "name": "execution_plans",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"execution_plans\" (\"id\" TEXT NOT NULL, \"mission_id\" TEXT NOT NULL UNIQUE REFERENCES missions (id), \"objective\" TEXT NOT NULL, \"steps\" TEXT NOT NULL DEFAULT '[]', \"verification_criteria\" TEXT NULL, \"notes\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    }
