          "sql": "CREATE TABLE IF NOT EXISTS \"failure_records\" (\"id\" TEXT NOT NULL, \"mission_id\" TEXT NOT NULL REFERENCES missions (id), \"trigger\" TEXT NOT NULL, \"occurred_at\" INTEGER NOT NULL, \"user_reason_category\" TEXT NULL, \"user_reason_text\" TEXT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"mission_id\", \"trigger\"), CHECK (\"trigger\" IN ('USER_MARKED_NOT_COMPLETED', 'EVIDENCE_DEADLINE_MISSED')), CHECK (user_reason_category IN ('TIME_INSUFFICIENT', 'TOO_DIFFICULT', 'URGENT_EVENT', 'BAD_STATE', 'DO_NOT_WANT_CONTINUE', 'ENVIRONMENT_PROBLEM', 'OTHER')));"
        }
      ]
