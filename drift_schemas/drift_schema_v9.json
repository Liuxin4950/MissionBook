        ],
        "name": "missions_ownership_update",
        "sql": "CREATE TRIGGER missions_ownership_update BEFORE UPDATE OF goal_id, goal_node_id ON missions\nWHEN NEW.goal_node_id IS NOT NULL AND NOT EXISTS (\n  SELECT 1 FROM goal_nodes WHERE id = NEW.goal_node_id AND goal_id = NEW.goal_id\n)\nBEGIN\n  SELECT RAISE(ABORT, 'mission node must belong to goal');\nEND;"
      }
