  "fixed_sql": [
    {
      "name": "goals",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"goals\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL CHECK (length(trim(title)) > 0), \"description\" TEXT NULL, \"why\" TEXT NULL, \"status\" TEXT NOT NULL DEFAULT 'ACTIVE', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (status IN ('ACTIVE', 'PAUSED', 'ACHIEVED', 'DROPPED')));"
        }
      ]
    },
    {
      "name": "goal_nodes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"goal_nodes\" (\"id\" TEXT NOT NULL, \"goal_id\" TEXT NOT NULL REFERENCES goals (id), \"parent_node_id\" TEXT NULL, \"title\" TEXT NOT NULL CHECK (length(trim(title)) > 0), \"description\" TEXT NULL, \"order_index\" INTEGER NOT NULL CHECK (order_index >= 0), \"archived_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (id, goal_id), FOREIGN KEY (parent_node_id, goal_id) REFERENCES goal_nodes (id, goal_id), CHECK (parent_node_id IS NULL OR parent_node_id <> id));"
        }
      ]
    },
    {
      "name": "missions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"missions\" (\"goal_id\" TEXT NULL REFERENCES goals (id), \"goal_node_id\" TEXT NULL CHECK(goal_node_id IS NULL OR goal_id IS NOT NULL) REFERENCES goal_nodes (id), \"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NULL, \"why\" TEXT NULL, \"verification_policy\" TEXT NOT NULL DEFAULT 'SELF_REPORT', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"cancelled_at\" INTEGER NULL, \"evidence_waived_at\" INTEGER NULL, \"source_mission_id\" TEXT NULL REFERENCES missions (id), \"relation_type\" TEXT NULL CHECK (relation_type IS NULL OR relation_type = 'RETRY'), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "missions_ownership_insert",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER missions_ownership_insert BEFORE INSERT ON missions WHEN NEW.goal_node_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM goal_nodes WHERE id = NEW.goal_node_id AND goal_id = NEW.goal_id) BEGIN SELECT RAISE (ABORT, 'mission node must belong to goal');END"
        }
      ]
    },
    {
      "name": "missions_ownership_update",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER missions_ownership_update BEFORE UPDATE OF goal_id, goal_node_id ON missions WHEN NEW.goal_node_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM goal_nodes WHERE id = NEW.goal_node_id AND goal_id = NEW.goal_id) BEGIN SELECT RAISE (ABORT, 'mission node must belong to goal');END"
        }
      ]
    },
    {
      "name": "goal_nodes_siblings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX goal_nodes_siblings ON goal_nodes (goal_id, parent_node_id, order_index)"
        }
      ]
    },
    {
      "name": "missions_goal_node",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX missions_goal_node ON missions (goal_id, goal_node_id)"
        }
      ]
    },
    {
      "name": "mission_schedule_revisions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"mission_schedule_revisions\" (\"id\" TEXT NOT NULL, \"mission_id\" TEXT NOT NULL REFERENCES missions (id), \"revision_number\" INTEGER NOT NULL, \"scheduled_date\" TEXT NOT NULL, \"time_zone\" TEXT NOT NULL, \"time_policy\" TEXT NOT NULL DEFAULT 'FLEXIBLE', \"fixed_start_at\" INTEGER NULL, \"planned_duration_minutes\" INTEGER NOT NULL, \"evidence_deadline_at\" INTEGER NULL, \"change_reason\" TEXT NULL, \"changed_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"mission_id\", \"revision_number\"));"
        }
      ]
    },
    {
      "name": "execution_plans",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"execution_plans\" (\"id\" TEXT NOT NULL, \"mission_id\" TEXT NOT NULL UNIQUE REFERENCES missions (id), \"objective\" TEXT NOT NULL, \"steps\" TEXT NOT NULL DEFAULT '[]', \"verification_criteria\" TEXT NULL, \"notes\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "execution_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"execution_events\" (\"id\" TEXT NOT NULL, \"mission_id\" TEXT NOT NULL REFERENCES missions (id), \"sequence\" INTEGER NOT NULL, \"type\" TEXT NOT NULL, \"occurred_at\" INTEGER NOT NULL, \"schedule_revision_id\" TEXT NULL REFERENCES mission_schedule_revisions (id), \"granted_duration_minutes\" INTEGER NULL, \"reason\" TEXT NULL, \"user_reported_result\" TEXT NULL, \"submit_optional_evidence\" INTEGER NULL CHECK (\"submit_optional_evidence\" IN (0, 1)), PRIMARY KEY (\"id\"), UNIQUE (\"mission_id\", \"sequence\"), CHECK (sequence > 0), CHECK (type IN ('START', 'PAUSE', 'RESUME', 'EXTEND', 'END')), CHECK (granted_duration_minutes > 0), CHECK (user_reported_result IN ('COMPLETED', 'NOT_COMPLETED')));"
        }
      ]
    },
