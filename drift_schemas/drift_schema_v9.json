      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"evidence_records\" (\"id\" TEXT NOT NULL, \"mission_id\" TEXT NOT NULL REFERENCES missions (id), \"submission_id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"source\" TEXT NOT NULL, \"content\" TEXT NULL, \"attachment_storage_key\" TEXT NULL UNIQUE, \"attachment_file_name\" TEXT NULL, \"attachment_mime_type\" TEXT NULL, \"captured_at\" INTEGER NULL, \"submitted_at\" INTEGER NOT NULL, \"supersedes_evidence_id\" TEXT NULL UNIQUE REFERENCES evidence_records (id), PRIMARY KEY (\"id\"), CHECK (((type IN ('TEXT', 'CODE', 'MANUAL_RECORD')) AND source = 'USER' AND content IS NOT NULL AND length(trim(content)) > 0 AND attachment_storage_key IS NULL AND attachment_file_name IS NULL AND attachment_mime_type IS NULL) OR (type = 'IMAGE' AND source IN ('FILE_SYSTEM', 'CAMERA') AND attachment_storage_key IS NOT NULL AND attachment_file_name IS NOT NULL) OR (type = 'FILE' AND source = 'FILE_SYSTEM' AND attachment_storage_key IS NOT NULL AND attachment_file_name IS NOT NULL)));"
        }
