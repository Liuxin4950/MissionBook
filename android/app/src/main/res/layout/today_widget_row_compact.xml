<?xml version="1.0" encoding="utf-8"?>
<!--
  宽槽三槽行：时间—任务—状态同一行。只有规划器判定可用宽足够时才使用；
  时间/状态关闭时对应 TextView 由 RemoteViews 设为 GONE，任务名占满剩余宽度。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_widget_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/today_widget_row_spine"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:layout_gravity="start" />

    <LinearLayout
        android:id="@+id/today_widget_row_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/today_widget_row_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/today_widget_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/today_widget_row_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/today_widget_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/today_widget_row_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/today_widget_accent"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:id="@+id/today_widget_row_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="bottom"
        android:background="@color/today_widget_hairline"
        android:importantForAccessibility="no" />
</FrameLayout>
