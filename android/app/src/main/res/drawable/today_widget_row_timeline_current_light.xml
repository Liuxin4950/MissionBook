<?xml version="1.0" encoding="utf-8"?>
<!-- 时间轴当前行：浅绿强调面、森林绿时间线和实心节点。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EEF4E7" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:left="3dp" android:width="2dp" android:gravity="start|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="#285D49" />
        </shape>
    </item>
    <item android:width="8dp" android:height="8dp" android:gravity="start|center_vertical">
        <shape android:shape="oval">
            <solid android:color="#285D49" />
        </shape>
    </item>
</layer-list>
