<?xml version="1.0" encoding="utf-8"?>
<!-- 时间轴普通行：浅色卡片、细时间线和空心节点。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:left="3dp" android:width="2dp" android:gravity="start|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="#D5DED8" />
        </shape>
    </item>
    <item android:width="8dp" android:height="8dp" android:gravity="start|center_vertical">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <stroke android:width="1dp" android:color="#718178" />
        </shape>
    </item>
</layer-list>
