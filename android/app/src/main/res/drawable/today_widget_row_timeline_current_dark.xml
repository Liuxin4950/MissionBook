<?xml version="1.0" encoding="utf-8"?>
<!-- 深色时间轴当前行。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2D4436" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:left="3dp" android:width="2dp" android:gravity="start|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="#A7C9B3" />
        </shape>
    </item>
    <item android:width="8dp" android:height="8dp" android:gravity="start|center_vertical">
        <shape android:shape="oval">
            <solid android:color="#A7C9B3" />
        </shape>
    </item>
</layer-list>
