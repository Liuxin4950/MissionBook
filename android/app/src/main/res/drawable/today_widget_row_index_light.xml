<?xml version="1.0" encoding="utf-8"?>
<!-- 索引卡使用极淡纸色，不再铺满整行绿底；保留左侧书脊作轻量层级提示。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F9FAF8" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:width="3dp" android:gravity="start">
        <shape android:shape="rectangle">
            <solid android:color="#244D3D" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
