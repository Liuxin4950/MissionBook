{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MissionBook 目标与任务导入包 v1（设计稿，应用尚未接入）",
  "description": "结构校验协议。跨节点引用、时区、总节点数、树深度、重复 key 和提交时限仍须业务校验。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "packageId", "goal", "defaults", "nodes", "missions"],
  "properties": {
    "schema": {"const": "mission-book.goal-package"},
    "version": {"type": "integer", "const": 1},
    "packageId": {"$ref": "#/$defs/packageKey"},
    "goal": {"$ref": "#/$defs/goal"},
    "defaults": {"$ref": "#/$defs/defaults"},
    "nodes": {
      "type": "array",
      "maxItems": 500,
      "items": {"$ref": "#/$defs/node"}
    },
    "missions": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/mission"}
    }
  },
  "$defs": {
    "packageKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "text": {
      "type": "string",
      "maxLength": 20000
    },
    "nonBlankText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "pattern": "\\S"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
      "not": {"pattern": "-00:00$"}
    },
    "timeZone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_+./-]+$"
    },
    "duration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1440
    },
    "verificationPolicy": {
      "enum": ["SELF_REPORT", "OPTIONAL_EVIDENCE", "REQUIRED_EVIDENCE"]
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": {"$ref": "#/$defs/title"},
        "description": {"$ref": "#/$defs/text"},
        "why": {"$ref": "#/$defs/text"}
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeZone", "plannedDurationMinutes", "verificationPolicy"],
      "properties": {
        "timeZone": {"$ref": "#/$defs/timeZone"},
        "plannedDurationMinutes": {"$ref": "#/$defs/duration"},
        "verificationPolicy": {"$ref": "#/$defs/verificationPolicy"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "title": {"$ref": "#/$defs/title"},
        "description": {"$ref": "#/$defs/text"},
        "children": {
          "type": "array",
          "maxItems": 500,
          "items": {"$ref": "#/$defs/node"}
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheduledDate", "timePolicy"],
      "properties": {
        "scheduledDate": {"$ref": "#/$defs/date"},
        "timePolicy": {"enum": ["FIXED", "FLEXIBLE"]},
        "timeZone": {"$ref": "#/$defs/timeZone"},
        "plannedDurationMinutes": {"$ref": "#/$defs/duration"},
        "fixedStartAt": {"$ref": "#/$defs/instant"},
        "evidenceDeadlineAt": {"$ref": "#/$defs/instant"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"timePolicy": {"const": "FIXED"}},
            "required": ["timePolicy"]
          },
          "then": {"required": ["fixedStartAt"]},
          "else": {"not": {"required": ["fixedStartAt"]}}
        }
      ]
    },
    "executionPlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objective": {"$ref": "#/$defs/title"},
        "steps": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          }
        },
        "verificationCriteria": {"$ref": "#/$defs/nonBlankText"},
        "notes": {"$ref": "#/$defs/text"}
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "schedule"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "nodeKey": {"$ref": "#/$defs/key"},
        "title": {"$ref": "#/$defs/title"},
        "description": {"$ref": "#/$defs/text"},
        "why": {"$ref": "#/$defs/text"},
        "verificationPolicy": {"$ref": "#/$defs/verificationPolicy"},
        "schedule": {"$ref": "#/$defs/schedule"},
        "executionPlan": {"$ref": "#/$defs/executionPlan"}
      }
    }
  }
}
